# Sleepoverr TEST environment settings.
#
#   dev/test-env.sh init   copies this file to dev/.env.test (gitignored) and fills every
#                          value marked __GENERATE__ with a fresh random secret.
#
# This file is used twice: as the compose --env-file (for the ${...} values in
# dev/docker-compose.test.yml) and as the sleepoverr container's env_file (app settings).
# Never put real production secrets here.

# ---------------------------------------------------------------------------------------
# Host ports (change if something on the host already uses them)
# ---------------------------------------------------------------------------------------
SLEEPOVERR_PORT=8000
MOCK_ROMM_PORT=8081
# Only used by the real-romm profile.
ROMM_PORT_TEST=8082

# ---------------------------------------------------------------------------------------
# Sleepoverr app (read by backend/app/core/config.py - see the repo-root .env.example for
# every option). These are throwaway test values.
# ---------------------------------------------------------------------------------------
JWT_SECRET_KEY=__GENERATE__
# Code the first-run "create admin" form asks for.
SETUP_CODE=__GENERATE__
LOG_LEVEL=INFO
# Optional: Sleepoverr's own IGDB lookups (also passed to the real-romm container below).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------
# Mock RomM (service mock-romm)
# ---------------------------------------------------------------------------------------
MOCK_ROMM_USER=admin
MOCK_ROMM_PASSWORD=__GENERATE__
# RomM-style Client API Token: "rmm_" + 64 hex characters. Sleepoverr authenticates with
# this as `Authorization: Bearer <token>`.
MOCK_ROMM_CLIENT_TOKEN=__GENERATE_RMM__
# Signing key for the mock's /api/token JWTs (random per start if empty).
MOCK_ROMM_JWT_SECRET=__GENERATE__

# ---------------------------------------------------------------------------------------
# Where Sleepoverr's future RomM sync points. NOT read by the app yet (later phase).
# Leave empty to use the mock (http://mock-romm:8080 + MOCK_ROMM_CLIENT_TOKEN).
#   real-romm profile:  ROMM_URL=http://romm:8080   ROMM_API_TOKEN=<token created in that RomM>
#   your own RomM:      ROMM_URL=https://romm.lan   ROMM_API_TOKEN=<READ-ONLY client token>
# ---------------------------------------------------------------------------------------
ROMM_URL=
ROMM_API_TOKEN=

# ---------------------------------------------------------------------------------------
# Real RomM (profile real-romm). Required by compose even in mock-only mode, so init
# always generates them.
# ---------------------------------------------------------------------------------------
ROMM_IMAGE=rommapp/romm:latest
ROMM_DB_IMAGE=mariadb:latest
# `openssl rand -hex 32`, as RomM's docs recommend.
ROMM_AUTH_SECRET_KEY=__GENERATE__
ROMM_DB_PASSWORD=__GENERATE__
ROMM_DB_ROOT_PASSWORD=__GENERATE__
# Optional metadata providers for the throwaway RomM (leave empty to stay offline).
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
RETROACHIEVEMENTS_API_KEY=
STEAMGRIDDB_API_KEY=
HASHEOUS_API_ENABLED=false
